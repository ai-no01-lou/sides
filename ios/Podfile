# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

# Suppress all warnings from third-party pods (deprecation warnings in
# react-native-keychain, react-native-webview, react-native-screens,
# react-native-gesture-handler, and React-Fabric headers).
inhibit_all_warnings!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Sides' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  # Copy placeholder dSYMs for prebuilt frameworks into the archive
  script_phase :name => 'Copy Prebuilt Framework dSYMs',
    :script => <<~SCRIPT,
      DSYM_SRC="${PODS_ROOT}/prebuilt-dsyms"
      if [ -d "$DSYM_SRC" ] && [ -n "$DWARF_DSYM_FOLDER_PATH" ]; then
        for dsym in "$DSYM_SRC"/*.dSYM; do
          [ -d "$dsym" ] || continue
          echo "Copying $(basename "$dsym") to $DWARF_DSYM_FOLDER_PATH"
          cp -R "$dsym" "$DWARF_DSYM_FOLDER_PATH/"
        done
      fi
    SCRIPT
    :execution_position => :after_compile

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Suppress "Upload Symbols Failed" for prebuilt frameworks that ship without dSYMs.
    # 1. Set dwarf-only for all pod targets (no dSYM generation for compiled pods)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        config.build_settings['DEBUG_INFORMATION_FORMAT'] = 'dwarf'
      end
    end

    # 2. Generate placeholder dSYMs for prebuilt frameworks (React, hermesvm,
    #    ReactNativeDependencies). These ship as prebuilt XCFrameworks with UUIDs
    #    but no dSYMs. App Store Connect validates the Mach-O file type, not
    #    just UUIDs — use dsymutil to create proper dSYM companion files.
    prebuilt_fw_paths = {
      'hermesvm' => Dir.glob("#{installer.sandbox.root}/**/ios-arm64/hermesvm.framework/hermesvm").first,
      'React' => Dir.glob("#{installer.sandbox.root}/**/ios-arm64/React.framework/React").first,
      'ReactNativeDependencies' => Dir.glob("#{installer.sandbox.root}/**/ios-arm64/ReactNativeDependencies.framework/ReactNativeDependencies").first,
    }
    dsym_output_dir = "#{installer.sandbox.root}/../Pods/prebuilt-dsyms"
    FileUtils.mkdir_p(dsym_output_dir)
    prebuilt_fw_paths.each do |name, fw_path|
      next unless fw_path && File.exist?(fw_path)
      dsym_path = "#{dsym_output_dir}/#{name}.framework.dSYM"
      Pod::UI.puts "Generating dSYM for #{name}.framework"
      FileUtils.rm_rf(dsym_path)
      system("xcrun dsymutil '#{fw_path}' -o '#{dsym_path}' 2>/dev/null")
    end
  end
end

# post_integrate runs AFTER CocoaPods writes the Pods project, so changes
# are not overwritten. Needed because [CP-User] script phases are installed
# after post_install, resetting always_out_of_date to nil.
post_integrate do |installer|
  # Mark all script phases as "run every build" so Xcode stops warning
  # about missing outputs (affects both Pods and Sides projects).
  pods_proj = begin; installer.pods_project; rescue; Xcodeproj::Project.open("#{installer.sandbox.root}/Pods.xcodeproj"); end
  sides_proj = Xcodeproj::Project.open("#{installer.sandbox.root}/../Sides.xcodeproj")

  [pods_proj, sides_proj].each do |project|
    project.targets.each do |target|
      target.build_phases.each do |phase|
        next unless phase.respond_to?(:always_out_of_date)
        phase.always_out_of_date = "1"
      end
    end
    project.save
  end
end
